# LLM provider: groq | openai | ollama
# Phase 3 uses Groq — set GROQ_API_KEY below
LLM_PROVIDER=groq

# Required for Phase 3 (Groq). Get a key at https://console.groq.com/
GROQ_API_KEY=

# Optional — only if you switch LLM_PROVIDER to openai
OPENAI_API_KEY=

# Groq model (default). Alternative: openai/gpt-oss-20b
LLM_MODEL=qwen/qwen3.8-27b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=30

# Ollama (only when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# Recommendation tuning
MAX_CANDIDATES=30
TOP_N_DEFAULT=5

# Budget tiers — cost for two (INR)
BUDGET_LOW_MAX=500
BUDGET_MEDIUM_MAX=1500

# Dataset
HF_DATASET_ID=ManikaSaini/zomato-restaurant-recommendation
PROCESSED_DATA_PATH=data/processed/restaurants.parquet
