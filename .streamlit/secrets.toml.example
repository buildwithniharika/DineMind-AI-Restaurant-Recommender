# Copy these keys into Streamlit Community Cloud → App settings → Secrets
# (Advanced settings when you first deploy). Do not commit a real secrets.toml.

LLM_PROVIDER = "groq"
GROQ_API_KEY = "gsk_your_key_here"
LLM_MODEL = "qwen/qwen3.8-27b"
LLM_TEMPERATURE = "0.3"
LLM_MAX_TOKENS = "2000"
LLM_TIMEOUT_SECONDS = "30"
MAX_CANDIDATES = "30"
TOP_N_DEFAULT = "5"
